VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DOOR_BUILDER_BASE_URL=https://www.hgidoorbuilder.com

# Vercel server functions only. Never prefix the OpenAI Admin key with VITE_.
OPENAI_ADMIN_API_KEY=

# Server-only 32-byte base64 key for CRM credentials. Never prefix with VITE_.
# Do not reuse this key for Door Builder webhooks.
CRM_CREDENTIAL_ENCRYPTION_KEY=

# Server-only 32-byte base64 key for Door Builder webhook URLs. Never prefix with VITE_.
# Set the same value on Door Builder. It cannot decrypt CRM credentials.
DOOR_BUILDER_WEBHOOK_ENCRYPTION_KEY=
